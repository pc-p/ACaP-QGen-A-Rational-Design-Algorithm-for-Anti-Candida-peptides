    if X_feats.shape[1] != len(feature_names):
        logger.error(f"Feature count mismatch: X_feats has {X_feats.shape[1]} features, but {len(feature_names)} names provided")
        raise ValueError("Feature count mismatch between X_feats and feature names")

    # 阶段 3：计算特征间相关性矩阵
    y = data['MIC_Standardized'].values
    correlations = {}
    for i, name in enumerate(feature_names):
        std_val = np.std(X_feats[:, i])
        if std_val > 0:
            correlations[name] = pearsonr(X_feats[:, i], y)[0]
        else:
            correlations[name] = 0.0 # 规避零方差特征导致的相关性计算报错
            
    correlation_df = pd.DataFrame(list(correlations.items()), columns=['Feature', 'Pearson_Correlation'])
    correlation_df.to_csv(OUTPUT_DIR / 'feature_correlations.csv', index=False)
    
    # 特征空间数值清洗 (屏蔽稀疏高维特征引起的 NaN 异常)
    logger.info("Cleaning extracted features (handling NaNs and infinities)...")
    X_feats = np.nan_to_num(X_feats, nan=0.0, posinf=0.0, neginf=0.0)
    
    # 数据集随机划分
    logger.info("Splitting data into training and testing sets...")
    indices = np.arange(len(data))
    X_train_main, X_test_main, y_train_main, y_test_main, train_indices, test_indices = train_test_split(
        X_feats, y, indices, test_size=0.2, random_state=42
    )

    # 超参数寻优网格设定
    catboost_param_grid = {
        'model__iterations': [200,300,400,500,600,700,800],
        'model__depth': [4,6,8,10],
        'model__learning_rate': [0.05,0.1,0.2,0.3],
        'model__l2_leaf_reg': [1,3,5,7,9],
        'model__bagging_temperature': [0.15,0.3,0.5,0.7],
        'model__border_count': [32,64,128,256],
        'model__grow_policy': ['SymmetricTree', 'Depthwise', 'Lossguide'],
        'model__bootstrap_type': ['Poisson'], 
        'model__subsample': [0.5,0.6,0.7,0.8,0.9]
    }

    results = []
    
    # 阶段 5：构建带有 GPU 算力后端的机器学习管道（保持原维，不降维）
    pipeline = Pipeline([
        ('scaler', RobustScaler()),
        ('model', CatBoostRegressor(
            random_state=42, 
            verbose=0, 
            early_stopping_rounds=50,
            task_type='GPU', 
            devices='0'      
        ))
    ])

    def optimize_catboost(trial, pipeline, param_grid, X, y):
        params = {}
        for key, values in param_grid.items():
            param_name = key.split('__')[1]
            if isinstance(values, list):
                params[key] = trial.suggest_categorical(param_name, values)
            elif isinstance(values, tuple) and len(values) == 2:
                params[key] = trial.suggest_float(param_name, values[0], values[1], log=True)
            else:
                params[key] = trial.suggest_int(param_name, values[0], values[1])
        pipeline.set_params(**params)
        score = cross_val_score(pipeline, X, y, cv=5, scoring='neg_mean_squared_error', n_jobs=1)
        return -score.mean()
    
    # 基于 Optuna 执行贝叶斯优化
    logger.info("Starting Optuna hyperparameter optimization for CatBoost (GPU backend enabled)...")
    print("Starting Optuna hyperparameter optimization for CatBoost...")
    study = optuna.create_study(direction='minimize', sampler=optuna.samplers.TPESampler(), pruner=optuna.pruners.MedianPruner())
    study.optimize(lambda trial: optimize_catboost(trial, pipeline, catboost_param_grid, X_train_main, y_train_main),
                   n_trials=200, timeout=7200)

    best_params = study.best_params
    pipeline.set_params(**{f'model__{k}': v for k, v in best_params.items()})
    
    # 阶段 6：模型拟合与特征可解释性萃取

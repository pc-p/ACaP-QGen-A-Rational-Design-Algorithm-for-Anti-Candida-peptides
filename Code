    feature_names.extend([f'Dipeptide_{aa1}{aa2}' for aa1 in 'ACDEFGHIKLMNPQRSTVWY' for aa2 in 'ACDEFGHIKLMNPQRSTVWY'])
    feature_names.extend(['Group_hydrophobic', 'Group_polar', 'Group_charged', 'Group_small', 'Group_aromatic'])
    feature_names.append('Sequence_Length')
    
    sorted_aaindex_names = sorted(aa_features_dict.keys())
    feature_names.extend([f'AAindex_{name}' for name in sorted_aaindex_names])
    
    # 保存特征结构以备后续可解释性分析
    sequence_features_df = pd.DataFrame(X_feats, columns=feature_names)
    sequence_features_df.to_csv(OUTPUT_DIR / 'sequence_features.csv', index=False)
    
    if X_feats.shape[1] != len(feature_names):
        logger.error(f"Feature count mismatch: X_feats has {X_feats.shape[1]} features, but {len(feature_names)} names provided")
        raise ValueError("Feature count mismatch between X_feats and feature names")

    # 阶段 3：特征清洗及数据集划分
    X_feats = np.nan_to_num(X_feats, nan=0.0, posinf=0.0, neginf=0.0)
    y_raw = data['MIC_Standardized'].to_numpy(dtype=float)
    indices = np.arange(len(data))
    train_indices, test_indices = train_test_split(
        indices, test_size=0.2, random_state=42
    )
    X_train_main = X_feats[train_indices]
    X_test_main = X_feats[test_indices]

    # Winsorization 截断阈值仅从训练集计算，避免使用测试集标签信息。
    q_low, q_high = np.quantile(y_raw[train_indices], [0.01, 0.99])
    y = np.clip(y_raw, q_low, q_high)
    y_train_main = y[train_indices]
    y_test_main = y[test_indices]

    # 仅在训练数据计算特征与靶值的相关性；只用于报告，不参与特征选择。
    correlations = {}
    for i, name in enumerate(feature_names):
        feat = X_train_main[:, i]
        if np.std(feat) > 0 and np.std(y_train_main) > 0:
            correlations[name] = float(pearsonr(feat, y_train_main)[0])
        else:
            correlations[name] = 0.0

    correlation_df = pd.DataFrame(
        list(correlations.items()), columns=['Feature', 'Pearson_Correlation']
    )
    correlation_df.to_csv(OUTPUT_DIR / 'feature_correlations.csv', index=False)

    # 阶段 4：分别优化 CatBoost 和随机森林的内部参数
    catboost_param_grid = {
        'iterations': [200, 300, 400, 500, 600, 700, 800],
        'depth': [4, 6, 8, 10],
        'learning_rate': [0.05, 0.1, 0.2, 0.3],
        'l2_leaf_reg': [1, 3, 5, 7, 9],
        'border_count': [32, 64, 128, 254],
        'grow_policy': ['SymmetricTree', 'Depthwise', 'Lossguide'],
        'bootstrap_type': ['Poisson'],
        'subsample': [0.5, 0.6, 0.7, 0.8, 0.9]
    }

    random_forest_param_grid = {
        'n_estimators': [200, 300, 400, 500, 700],
        'max_depth': [None, 8, 12, 20, 30],
        'min_samples_split': [2, 4, 8, 12],
        'min_samples_leaf': [1, 2, 4, 6],
        'max_features': ['sqrt', 0.3, 0.5, 0.8, 1.0],
        'bootstrap': [True, False]
    }

    # 与原代码一致，CatBoost 使用 Kaggle GPU；随机森林用 CPU 并行。
    # 先分别优化基模型，然后优化两者的预测融合权重；最终只有一个集成模型。
    model_configs = [
        {
            'name': 'CatBoost',
            'estimator': CatBoostRegressor(
                random_state=42, verbose=0, task_type='GPU', devices='0'
            ),
            'param_grid': catboost_param_grid,
            'n_trials': 200,
            'timeout': 7200
        },
        {
            'name': 'RandomForest',
            'estimator': RandomForestRegressor(
                random_state=42, n_jobs=-1
            ),
            'param_grid': random_forest_param_grid,
            'n_trials': 80,
            'timeout': 3600
        }
    ]

    optuna_cv = KFold(n_splits=5, shuffle=True, random_state=42)
    evaluation_cv = KFold(n_splits=10, shuffle=True, random_state=42)
    best_param_sets = {}
    optimized_estimators = {}

    def cross_validated_mse(estimator, X, targets, splitter):
        errors = []
        for fit_idx, valid_idx in splitter.split(X, targets):
            clone_model = clone(estimator)
            clone_model.fit(X[fit_idx], targets[fit_idx])
            predictions = clone_model.predict(X[valid_idx])
            errors.append(
                mean_squared_error(targets[valid_idx], predictions)
            )
        return np.asarray(errors, dtype=float)

    for config in model_configs:
        name = config['name']
        base_estimator = config['estimator']
        logger.info(f'Optimizing internal model: {name}')

        def objective(trial):
            param_values = {
                parameter: trial.suggest_categorical(parameter, options)
                for parameter, options in config['param_grid'].items()
            }
            trial_estimator = clone(base_estimator)
            trial_estimator.set_params(**param_values)
            return float(
                cross_validated_mse(
                    trial_estimator, X_train_main, y_train_main, optuna_cv
                ).mean()
            )

        study = optuna.create_study(
            direction='minimize',
            sampler=optuna.samplers.TPESampler(seed=42)
        )
        study.optimize(
            objective,
            n_trials=config['n_trials'],
            timeout=config['timeout']
        )

        best_param_sets[name] = study.best_params
        optimized_estimators[name] = clone(base_estimator).set_params(
            **study.best_params
        )
        logger.info(f'{name} best params: {study.best_params}')

    catboost_estimator = optimized_estimators['CatBoost']
    forest_estimator = optimized_estimators['RandomForest']

    # 阶段 5：使用训练集的折外预测 (OOF) 选择集成权重。
    oof_preds = make_oof_predictions(
        [catboost_estimator, forest_estimator],
        X_train_main,
        y_train_main,
        optuna_cv
    )
    ensemble_weights = choose_ensemble_weights(y_train_main, oof_preds)
    catboost_weight, forest_weight = ensemble_weights

    logger.info(
        f'Ensemble weights: CatBoost={catboost_weight:.4f}, '
        f'RandomForest={forest_weight:.4f}'
    )
    print(
        f'Ensemble weights -> CatBoost: {catboost_weight:.4f}, '
        f'RandomForest: {forest_weight:.4f}'
    )

    # 阶段 6：10 折验证，只评价融合后的单一模型。
    # 该值属于训练集内部诊断；超参数和融合权重由同一训练集决定。
    # 独立测试集性能才是最终外部验证指标。
    train_cv_errors = []
    for train_fold_idx, valid_fold_idx in evaluation_cv.split(
        X_train_main, y_train_main
    ):
        cb_fold = clone(catboost_estimator)
        rf_fold = clone(forest_estimator)
        cb_fold.fit(
            X_train_main[train_fold_idx], y_train_main[train_fold_idx]
        )
        rf_fold.fit(
            X_train_main[train_fold_idx], y_train_main[train_fold_idx]
        )

        combined_predictions = (
            catboost_weight * cb_fold.predict(X_train_main[valid_fold_idx])
            + forest_weight * rf_fold.predict(X_train_main[valid_fold_idx])
        )
        train_cv_errors.append(
            mean_squared_error(
                y_train_main[valid_fold_idx], combined_predictions
            )
        )

    train_cv_errors = np.asarray(train_cv_errors, dtype=float)

    # 阶段 7：训练两个子模型并融合为一个标准 sklearn VotingRegressor。
    # CatBoost 旧版本与 sklearn 新版标签接口不兼容，先分别 fit，
    # 再组合到预拟合 VotingRegressor，以保证单一 pkl 可以直接 predict。
    logger.info('Fitting the final CatBoost + RandomForest ensemble...')
    trained_catboost = clone(catboost_estimator)
    trained_forest = clone(forest_estimator)
    trained_catboost.fit(X_train_main, y_train_main)
    trained_forest.fit(X_train_main, y_train_main)

    ensemble_model = make_fitted_voting_regressor(
        trained_catboost, trained_forest, ensemble_weights
    )

    # 保存特征映射元信息，避免后续预测时 AAindex 的排列顺序发生变化。
    ensemble_model.feature_names_ = feature_names
    ensemble_model.aaindex_features_ = aa_features_dict
    ensemble_model.target_clip_bounds_ = (float(q_low), float(q_high))

    # 验证 VotingRegressor 的预测与人工加权求和一致。
    prediction_check = (
        catboost_weight * trained_catboost.predict(X_test_main)
        + forest_weight * trained_forest.predict(X_test_main)
    )
    if not np.allclose(
        ensemble_model.predict(X_test_main), prediction_check,
        atol=1e-7, rtol=1e-7
    ):
        raise RuntimeError('Ensemble prediction does not match weighted sum.')

    # 阶段 8：只评估集成模型，不分别导出 CatBoost / RF 的结果。
    metrics, y_pred_test = evaluate_model(
        ensemble_model, X_test_main, y_test_main
    )
    logger.info(
        f'Ensemble independent test: MSE={metrics["Test_MSE"]:.4f}, '
        f'MAE={metrics["Test_MAE"]:.4f}, R2={metrics["Test_R2"]:.4f}'
    )

    # 只有一份完整预测 CSV，使用 Dataset_Split 字段区分训练/测试。
    # 训练样本为拟合内预测；测试样本才可用于独立性能评估。
    y_pred_all = ensemble_model.predict(X_feats)
    split_labels = np.full(len(data), 'Train', dtype=object)
    split_labels[test_indices] = 'Test'

    prediction_df = pd.DataFrame({
        'Index': indices,
        'Dataset_Split': split_labels,
        'Sequence': data['Sequence'].to_numpy(),
        'True_MIC_Standardized': y,
        'Predicted_MIC_Standardized': y_pred_all
    })
    prediction_df['Residual'] = (
        prediction_df['True_MIC_Standardized']
        - prediction_df['Predicted_MIC_Standardized']
    )
    prediction_df.to_csv(
        OUTPUT_DIR / 'mic_predictions.csv', index=False
    )

    # 保存一份融合后的特征重要性。先分别归一化两个模型的得分，
    # 再按融合权重加权平均；该指标是描述性汇总，不是因果解释。
    cb_importance = np.asarray(
        trained_catboost.get_feature_importance(), dtype=float
    )
    rf_importance = np.asarray(
        trained_forest.feature_importances_, dtype=float
    )
    cb_importance = np.maximum(cb_importance, 0.0)
    rf_importance = np.maximum(rf_importance, 0.0)
    cb_importance = cb_importance / max(cb_importance.sum(), 1e-12)
    rf_importance = rf_importance / max(rf_importance.sum(), 1e-12)

    fused_importance = (
        catboost_weight * cb_importance
        + forest_weight * rf_importance
    )
    feature_scores_df = pd.DataFrame({
        'Feature_Name': feature_names,
        'Importance_Score': fused_importance
    }).sort_values('Importance_Score', ascending=False)

def make_oof_predictions(estimators, X, y, splitter):
    """仅利用训练集，通过交叉验证为多个回归器生成折外预测。"""
    predictions = np.full((X.shape[0], len(estimators)), np.nan, dtype=float)
    for fold_number, (fit_idx, valid_idx) in enumerate(splitter.split(X, y), start=1):
        logger.info(f'Generating out-of-fold predictions: fold {fold_number}')
        for model_idx, estimator in enumerate(estimators):
            current_model = clone(estimator)
            current_model.fit(X[fit_idx], y[fit_idx])
            predictions[valid_idx, model_idx] = current_model.predict(X[valid_idx])

    if not np.isfinite(predictions).all():
        raise ValueError('Failed to generate complete out-of-fold predictions.')
    return predictions


def choose_ensemble_weights(y, oof_predictions, min_weight=0.05):
    """
    以训练集 OOF 的 MSE 最小化确定凸组合权重。
    强制两个基模型均参与预测，每个模型权重至少为 min_weight。
    测试集不参与权重学习。
    """
    cb_pred = oof_predictions[:, 0]
    rf_pred = oof_predictions[:, 1]
    delta = cb_pred - rf_pred
    denominator = float(np.dot(delta, delta))
    if denominator < 1e-12:
        cb_weight = 0.5
    else:
        cb_weight = float(np.dot(y - rf_pred, delta) / denominator)
    cb_weight = float(np.clip(cb_weight, min_weight, 1.0 - min_weight))
    return cb_weight, 1.0 - cb_weight


def make_fitted_voting_regressor(fitted_catboost, fitted_random_forest, weights):
    """
    将两个已经拟合的模型作为一个 sklearn VotingRegressor 保存。
    当前 CatBoost 版本在部分新版 sklearn 环境中未实现 __sklearn_tags__，
    故不调用 VotingRegressor.fit（该方法会重复拟合并触发标签兼容问题），
    而是安装其所需的 fitted attributes。保存后的对象直接支持 .predict(X)。
    """
    ensemble = VotingRegressor(
        estimators=[
            ('catboost', fitted_catboost),
            ('random_forest', fitted_random_forest)
        ],
        weights=list(weights)
    )
    ensemble.estimators_ = [fitted_catboost, fitted_random_forest]
    ensemble.named_estimators_ = Bunch(
        catboost=fitted_catboost,
        random_forest=fitted_random_forest
    )
    return ensemble


def aggregate_exact_duplicate_sequences(data):
    """
    完全相同的清洗后氨基酸序列：MIC_Standardized 按算术平均合并。
    不对仅相似的序列取均值；保留复测数量和活性范围供审查。
    """
    grouped = (
        data.groupby('Sequence', as_index=False, sort=False)['MIC_Standardized']
        .agg(
            MIC_Standardized='mean',
            Replicate_Count='size',
            MIC_Min='min',
            MIC_Max='max',
            MIC_SD='std'
        )
    )
    grouped['MIC_SD'] = grouped['MIC_SD'].fillna(0.0)
    grouped['Length'] = grouped['Sequence'].str.len()
    return grouped


def parse_cdhit_clusters(cluster_file, expected_ids):
    """严格读取 CD-HIT 的 .clstr 文件：映射每条序列到所属簇及代表序列。"""
    groups = []
    cluster_id = None
    seen_ids = set()
    reps_by_cluster = {}

    for raw_line in cluster_file.read_text(encoding='utf-8').splitlines():
        line = raw_line.strip()
        if line.startswith('>Cluster '):
            cluster_id = int(line.split()[-1])
            continue
        if not line:
            continue
        if cluster_id is None:
            raise ValueError('CD-HIT .clstr contains a member before cluster header.')

        member_match = re.search(r'>(seq\d+)\.\.\.', line)
        if member_match is None:
            raise ValueError(f'Unexpected CD-HIT .clstr member line: {line}')
        member_id = member_match.group(1)
        if member_id in seen_ids:
            raise ValueError(f'Duplicate member ID in CD-HIT output: {member_id}')
        seen_ids.add(member_id)

        is_rep = line.endswith('*')
        if is_rep:
            if cluster_id in reps_by_cluster:
                raise ValueError(f'Multiple representatives in cluster {cluster_id}')
            reps_by_cluster[cluster_id] = member_id

        groups.append({
            'Member_ID': member_id,
            'Cluster_ID': cluster_id,
            'Is_Representative': is_rep
        })

    if seen_ids != set(expected_ids):
        missing = set(expected_ids) - seen_ids
        unexpected = seen_ids - set(expected_ids)
        raise ValueError(
            f'Incomplete CD-HIT cluster mapping: missing={len(missing)}, '
            f'unexpected={len(unexpected)}.'
        )
    clusters = {row['Cluster_ID'] for row in groups}
    if clusters != set(reps_by_cluster):
        raise ValueError('CD-HIT output has one or more clusters without a representative.')
    for item in groups:
        item['Representative_ID'] = reps_by_cluster[item['Cluster_ID']]
    return pd.DataFrame(groups)


def run_cdhit_90(unique_data, output_dir):
    """
    对精确去重后的数据运行蛋白质 CD-HIT：90% identity。
    .clstr 的代表序列保留其自身的 MIC 均值；近似序列不平均活性。
    """
    executable = os.environ.get('CDHIT_BIN', 'cd-hit')
    resolved = shutil.which(executable)
    if resolved is None:
        raise FileNotFoundError(
            "找不到 CD-HIT 可执行文件。请先在 Kaggle Notebook 单元执行 "
            "'!apt-get update -qq && apt-get install -y -qq cd-hit'，"
            "或者设置环境变量 CDHIT_BIN 为 cd-hit 的完整路径。"
        )

    unique_data = unique_data.reset_index(drop=True).copy()
    unique_data['Member_ID'] = [
        f'seq{idx:08d}' for idx in range(len(unique_data))
    ]
    expected_ids = unique_data['Member_ID'].tolist()
    output_dir = Path(output_dir)

    with tempfile.TemporaryDirectory(prefix='mic_cdhit90_') as temp_name:
        work_dir = Path(temp_name)
        fasta_in = work_dir / 'unique_peptides.fasta'
        fasta_out = work_dir / 'cdhit90_representatives.fasta'

        with fasta_in.open('w', encoding='utf-8') as handle:
            for row in unique_data.itertuples(index=False):
                handle.write(f'>{row.Member_ID}\n{row.Sequence}\n')

        command = [
            resolved,
            '-i', str(fasta_in), '-o', str(fasta_out),
            '-c', str(CDHIT_THRESHOLD), '-n', str(CDHIT_WORD_SIZE),
            '-G', '1',
            '-aL', str(CDHIT_COVERAGE), '-aS', str(CDHIT_COVERAGE),
            '-l', str(CDHIT_MIN_DISCARD_LENGTH),
            '-d', '0', '-M', '0', '-T', str(min(os.cpu_count() or 1, 4))
        ]
        logger.info('Running CD-HIT 90%%: %s', ' '.join(command))
        try:
            outcome = subprocess.run(
                command, capture_output=True, text=True, check=True
            )
        except subprocess.CalledProcessError as exc:
            raise RuntimeError(
                f'CD-HIT clustering failed (exit={exc.returncode}). '
                f'stderr: {exc.stderr[-2000:]} '
                f'stdout: {exc.stdout[-2000:]}'
            ) from exc

        logger.info('CD-HIT output: %s', outcome.stdout[-1200:])
        clstr_path = Path(str(fasta_out) + '.clstr')
        if not fasta_out.is_file() or not clstr_path.is_file():
            raise FileNotFoundError('CD-HIT did not create representative FASTA and .clstr files.')

        cluster_mapping = parse_cdhit_clusters(clstr_path, expected_ids)

        # 同时核对 FASTA 的代表序列 ID，防止错误解析或短肽被静默过滤。
        fasta_representatives = set(
            re.findall(r'^>(\S+)', fasta_out.read_text(encoding='utf-8'), re.M)
        )
        clstr_representatives = set(
            cluster_mapping.loc[
                cluster_mapping['Is_Representative'], 'Member_ID'
            ]
        )
        if fasta_representatives != clstr_representatives:
            raise RuntimeError('CD-HIT FASTA and .clstr representative IDs differ.')

    mapping = unique_data.merge(
        cluster_mapping, how='inner', on='Member_ID', validate='one_to_one'
    )
    if len(mapping) != len(unique_data):
        raise RuntimeError('CD-HIT mapping count does not match unique sequence count.')
    id_to_sequence = dict(zip(unique_data['Member_ID'], unique_data['Sequence']))
    mapping['Representative_Sequence'] = mapping['Representative_ID'].map(id_to_sequence)

    # 仅选 CD-HIT 的代表序列，一簇保留一条记录。
    representative_data = (
        mapping.loc[mapping['Is_Representative']]
        .sort_values('Cluster_ID')
        .copy()
    )
    representative_data['Cluster_Size'] = (
        representative_data['Cluster_ID']
        .map(mapping.groupby('Cluster_ID').size())
        .astype(int)
    )
    representative_data = representative_data[
        ['Sequence', 'MIC_Standardized', 'Replicate_Count',
         'MIC_Min', 'MIC_Max', 'MIC_SD', 'Length', 'Cluster_ID', 'Cluster_Size']
    ].reset_index(drop=True)
    mapping = mapping[
        ['Member_ID', 'Cluster_ID', 'Sequence', 'MIC_Standardized',
         'Replicate_Count', 'MIC_Min', 'MIC_Max', 'Is_Representative',
         'Representative_Sequence']
    ]

    # 记录可复核的去冗余映射和最终建模数据。
    mapping.to_csv(output_dir / 'cdhit90_cluster_mapping.csv', index=False)
    representative_data.to_csv(
        output_dir / 'cdhit90_modeling_dataset.csv', index=False
    )
    return representative_data, mapping



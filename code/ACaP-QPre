# 特征提取类定义（已移除三肽高维稀疏特征）
class SequenceFeatureExtractor:
    def __init__(self):
        self.aa_groups = {
            'hydrophobic': 'AILMFWYV',
            'polar': 'QNSTC',
            'charged': 'KRHDE',
            'small': 'GPASC',
            'aromatic': 'FYW'
        }

    def get_aa_composition(self, sequence):
        length = len(sequence)
        if length == 0:
            return [0] * 20
        aa_counts = {aa: sequence.count(aa) / length for aa in 'ACDEFGHIKLMNPQRSTVWY'}
        return [aa_counts.get(aa, 0) for aa in 'ACDEFGHIKLMNPQRSTVWY']

    def get_dipeptide_composition(self, sequence):
        length = len(sequence) - 1
        if length <= 0:
            return [0] * (20 * 20)
        dipeptides = [sequence[i:i+2] for i in range(length)]
        dipeptide_counts = {}
        for dp in dipeptides:
            dipeptide_counts[dp] = dipeptide_counts.get(dp, 0) + 1
        return [dipeptide_counts.get(aa1 + aa2, 0) / length for aa1 in 'ACDEFGHIKLMNPQRSTVWY' for aa2 in 'ACDEFGHIKLMNPQRSTVWY']

    def get_group_composition(self, sequence):
        length = len(sequence)
        if length == 0:
            return [0] * 5
        group_counts = {group: sum(1 for aa in sequence if aa in aas) / length for group, aas in self.aa_groups.items()}
        return [group_counts.get(group, 0) for group in ['hydrophobic', 'polar', 'charged', 'small', 'aromatic']]

    def extract_all_features(self, sequence):
        return (
            self.get_aa_composition(sequence) +
            self.get_dipeptide_composition(sequence) +
            self.get_group_composition(sequence) +
            [len(sequence)]
        )

# 自适应 AAindex 特征加载器（兼容泛化对象存储结构）
def load_aaindex_features(path):
    aa_features_dict = {}
    path = Path(path)
    
    # 构建兼容大小写后缀的文件迭代器
    pkl_files = list(path.glob('*.pkl')) + list(path.glob('*.PKL'))
    
    if not pkl_files:
        logger.error(f"严重警告：路径 {path} 下未检索到任何 .pkl 格式的理化特征文件。请核对挂载路径。")
        print(f"CRITICAL WARNING: No .pkl files found in {path}.")
        return aa_features_dict

    for file in pkl_files:
        try:
            features = joblib.load(file)
            valid_features = {}
            
            # 策略化降解：将 Pandas 数据结构泛化为标准 Python 字典
            if isinstance(features, pd.Series):
                features = features.to_dict()
            elif isinstance(features, pd.DataFrame):
                # 提取首列特征并转换为字典
                features = features.iloc[:, 0].to_dict()
            elif hasattr(features, 'item') and hasattr(features, 'shape') and features.shape == ():
                # 兼容 NumPy 标量字典
                features = features.item()
                
            # 执行特征空间投影与强制数值转换
            if isinstance(features, dict):
                for aa, value in features.items():
                    if aa in 'ACDEFGHIKLMNPQRSTVWY':
                        try:
                            # 强制转换为原生浮点型，规避 NumPy 类型不兼容障碍
                            valid_features[aa] = float(value)
                        except (ValueError, TypeError):
                            continue
                            
            if valid_features:
                aa_features_dict[file.stem] = valid_features
            else:
                logger.warning(f"特征解析异常：文件 {file.name} 未能输出有效的氨基酸映射规则。")
                
        except Exception as e:
            logger.error(f"IO 阻塞或解析崩溃 {file.name}: {e}", exc_info=True)
            
    logger.info(f"成功挂载并解析 {len(aa_features_dict)} 个 AAindex 独立特征簇。")
    print(f"Successfully loaded {len(aa_features_dict)} AAindex features.")
    
    return aa_features_dict

# 执行高维序列特征与 AAindex 特征的级联映射
def compute_sequence_features(seq, aa_features_dict, feature_extractor):
    sequence_features = feature_extractor.extract_all_features(seq)
    
    aaindex_features = []
    sorted_index_names = sorted(aa_features_dict.keys())
    
    for index_name in sorted_index_names:
        prop_dict = aa_features_dict[index_name]
        valid_values = [prop_dict[aa] for aa in seq if aa in prop_dict and prop_dict[aa] is not None]
        
        if valid_values:
            seq_prop_mean = np.mean(valid_values)
        else:
            seq_prop_mean = 0.0
        aaindex_features.append(seq_prop_mean)
        
    sequence_features.extend(aaindex_features)
    return sequence_features

# 序列数据标准化清洗
def clean_sequence(seq, min_length=5, max_length=1000):
    if not isinstance(seq, str):
        return np.nan
    cleaned = re.sub(r'[^ACDEFGHIKLMNPQRSTVWY]', '', seq.upper())
    if min_length <= len(cleaned) <= max_length:
        return cleaned
    return np.nan

# 定义模型性能评估体系
def evaluate_model(model, X_test, y_test):
    y_pred = model.predict(X_test)
    mse = mean_squared_error(y_test, y_pred)
    mae = mean_absolute_error(y_test, y_pred)
    r2 = r2_score(y_test, y_pred)
    evs = explained_variance_score(y_test, y_pred)
    pearson_corr, _ = pearsonr(y_test, y_pred)
    spearman_corr, _ = spearmanr(y_test, y_pred)
    metrics = {
        'Test_MSE': mse,
        'Test_MAE': mae,
        'Test_R2': r2,
        'Test_Explained_Variance': evs,
        'Pearson_Correlation': pearson_corr,
        'Spearman_Correlation': spearman_corr
    }
    return metrics, y_pred

